/vm/__pycache__/
!/setup-rea
!/rea-tool
!/local-login
!/local-login-guest
!/pull-all
!/pull-all.sh
!/push-all.sh
!/tests/
/tests/*
!/tests/test_pull_all.py
!/tests/test_vm_runner.py
