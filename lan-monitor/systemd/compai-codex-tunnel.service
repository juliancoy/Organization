[Unit]
Description=CompAI Codex HTTPS tunnel
After=network-online.target compai-codex.service
Wants=compai-codex.service
[Service]
ExecStart=/home/julian/.local/bin/cloudflared --no-autoupdate tunnel run --token-file /home/julian/.config/map-master/compai-tunnel-token
Restart=always
RestartSec=5
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=default.target
