[Unit]
Description=CompAI owner-authenticated Codex web controls
After=network-online.target
[Service]
WorkingDirectory=/home/julian/Documents/Organization/lan-monitor
Environment=CODEX_PUBLIC_ORIGIN=https://compai.lifetech.fyi
ExecStart=/usr/bin/python3 /home/julian/Documents/Organization/lan-monitor/codex_remote.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=default.target
