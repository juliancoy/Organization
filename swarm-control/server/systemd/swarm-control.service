[Unit]
Description=Swarm Control coordinator and local monitoring API
After=network-online.target
PartOf=swarm-control.target

[Service]
Environment=SWARM_WORKSPACE={{WORKSPACE}}
Environment=SWARM_STATE_DIR={{STATE}}
WorkingDirectory={{SOURCE}}/server
ExecStart={{PYTHON}} {{SOURCE}}/server/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=swarm-control.target
